# The public origin of the deployment, with protocol and no trailing slash.
#
# MUST be set as a BUILD-time variable on the host. Every route is statically
# prerendered, so the absolute OG/Twitter image URLs are baked into the HTML
# during `next build` — a runtime-only variable is too late and the cards
# unfurl pointing at localhost.
#
#   Vercel:     Project Settings -> Environment Variables (Production/Preview)
#   Cloudflare: the build environment variables of the Pages/Workers project
#
# Leave unset locally: the fallback chain in lib/site.ts resolves the platform
# preview domain, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://example.com
